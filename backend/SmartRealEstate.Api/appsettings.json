    "BucketName": "smart-real-estate-bucket",
    "Region": "us-east-1",
    "AccessKey": "YOUR_AWS_ACCESS_KEY_ID",
    "SecretKey": "YOUR_AWS_SECRET_ACCESS_KEY"
  },
  "OpenAiSettings": {
    "ApiKey": "YOUR_OPENAI_API_KEY"
  }
}
