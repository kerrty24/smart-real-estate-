{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=127.0.0.1;Port=3306;Database=smart_real_estate_db;User=root;Password=;"
  },
  "JwtSettings": {
    "Secret": "SmartRealEstateSuperSecretKeyChangeThisInProduction123456!",
